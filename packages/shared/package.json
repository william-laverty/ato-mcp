{
  "name": "@ato-mcp/shared",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools/search": {
      "types": "./dist/tools/search.d.ts",
      "import": "./dist/tools/search.js"
    },
    "./tools/get_chunks": {
      "types": "./dist/tools/get_chunks.d.ts",
      "import": "./dist/tools/get_chunks.js"
    },
    "./tools/fetch": {
      "types": "./dist/tools/fetch.d.ts",
      "import": "./dist/tools/fetch.js"
    },
    "./tools/stats": {
      "types": "./dist/tools/stats.d.ts",
      "import": "./dist/tools/stats.js"
    },
    "./tools/get_definition": {
      "types": "./dist/tools/get_definition.d.ts",
      "import": "./dist/tools/get_definition.js"
    },
    "./tools/get_doc": {
      "types": "./dist/tools/get_doc.d.ts",
      "import": "./dist/tools/get_doc.js"
    },
    "./tools/get_doc_anchors": {
      "types": "./dist/tools/get_doc_anchors.d.ts",
      "import": "./dist/tools/get_doc_anchors.js"
    },
    "./tools/get_threshold": {
      "types": "./dist/tools/get_threshold.d.ts",
      "import": "./dist/tools/get_threshold.js"
    },
    "./tools/get_user_facts": {
      "types": "./dist/tools/get_user_facts.d.ts",
      "import": "./dist/tools/get_user_facts.js"
    },
    "./lib/rrf": {
      "types": "./dist/lib/rrf.d.ts",
      "import": "./dist/lib/rrf.js"
    },
    "./lib/citations": {
      "types": "./dist/lib/citations.d.ts",
      "import": "./dist/lib/citations.js"
    },
    "./tools/deduction_discovery": {
      "types": "./dist/tools/deduction_discovery.d.ts",
      "import": "./dist/tools/deduction_discovery.js"
    },
    "./tools/depreciation_helper": {
      "types": "./dist/tools/depreciation_helper.d.ts",
      "import": "./dist/tools/depreciation_helper.js"
    },
    "./tools/bas_prep_checklist": {
      "types": "./dist/tools/bas_prep_checklist.d.ts",
      "import": "./dist/tools/bas_prep_checklist.js"
    },
    "./tools/audit_risk_check": {
      "types": "./dist/tools/audit_risk_check.d.ts",
      "import": "./dist/tools/audit_risk_check.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:deductions": "node scripts/gen-deduction-categories.mjs"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  },
  "description": "Shared tool core for ato-mcp: types, Zod schemas, Store/Embedder interfaces, and the 13 MCP tool implementations used by both local and hosted modes.",
  "keywords": [
    "mcp",
    "ato",
    "australian-tax",
    "tax",
    "australia"
  ],
  "license": "MIT",
  "author": "William Laverty",
  "homepage": "https://ato-mcp.com.au",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/william-laverty/ato-mcp.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/william-laverty/ato-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
