{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --filter \"@ato-pro/backend...\" --frozen-lockfile --config.confirmModulesPurge=false",
  "buildCommand": "cd ../.. && pnpm --filter @ato-pro/shared build && pnpm --filter @ato-pro/backend build",
  "rewrites": [
    { "source": "/:path((?!api|public).*)", "destination": "/api/:path" }
  ]
}
