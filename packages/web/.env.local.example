# Copy this file to .env.local and fill in real values.
# Without these values set, the app uses mock Supabase clients (MOCK_SUPABASE=1 behaviour).

# Supabase project URL (Settings → Data API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable key — replaces the legacy anon key. Safe to expose to the browser.
# Settings → API Keys → "Publishable key" (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase secret key — replaces the legacy service_role key. Server-side only.
# Settings → API Keys → "Secret key" (starts with sb_secret_)
# NEVER expose this to the browser. It bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to "1" to force mock Supabase clients in dev (default when the keys above are missing)
# MOCK_SUPABASE=1
