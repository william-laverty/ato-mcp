{
  "name": "ato-mcp",
  "version": "1.1.1",
  "description": "Hosted MCP server for the Australian Taxation Office corpus — cited tax retrieval, personal context, and workflow tools for AI agents.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ato",
    "australian-tax",
    "tax",
    "australia",
    "claude",
    "ai-agent",
    "rag",
    "itaa-1997"
  ],
  "license": "MIT",
  "author": "William Laverty",
  "homepage": "https://ato-mcp.com.au",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/william-laverty/ato-mcp.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/william-laverty/ato-mcp/issues"
  },
  "type": "module",
  "bin": {
    "ato-mcp": "./bin/ato-mcp.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "rm -rf dist && tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.4",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
