{
  "name": "ato-mcp",
  "version": "2.0.0",
  "description": "Your AI agent, fluent in Australian tax. MCP server with cited answers from 34,500+ ATO documents, the income tax and GST Acts and 4,900+ rulings \u2014 plus deduction, depreciation, BAS and audit-risk tools that know your tax profile.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ato",
    "australian-tax",
    "tax",
    "australia",
    "claude",
    "ai-agent",
    "rag",
    "itaa-1997",
    "mcp-server",
    "gst",
    "tax-deductions"
  ],
  "license": "MIT",
  "author": "William Laverty",
  "homepage": "https://ato-mcp.com.au",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/william-laverty/ato-mcp.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/william-laverty/ato-mcp/issues"
  },
  "type": "module",
  "bin": {
    "ato-mcp": "bin/ato-mcp.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "rm -rf dist && tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mcp-remote": "^0.1.38"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
